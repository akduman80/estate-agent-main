APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=tr
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=tr_TR

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

ADMIN_APPROVAL_EMAIL=info@zydemlak.com.tr
EMAIL_OTP_TTL_MINUTES=5
EMAIL_OTP_MAX_ATTEMPTS=5
EMAIL_OTP_LOCK_MINUTES=15
EMAIL_OTP_RESEND_SECONDS=60
EMAIL_OTP_HOURLY_LIMIT=5
PHONE_OTP_DRIVER=log

# Yalnızca geliştirme/tohum kullanıcıları için. Canlıda güçlü ve benzersiz değerler kullanın.
SEED_ADMIN_PASSWORD=LocalAdmin123!
SEED_AGENT_PASSWORD=LocalAgent123!
SEED_EDITOR_PASSWORD=LocalEditor123!

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

PROJECT_VIDEO_MAX_SIZE_KB=204800

GITHUB_DEPLOY_SECRET=
GITHUB_DEPLOY_BRANCH=main
GITHUB_DEPLOY_SERVICE=estate-agent-deploy.service

# Mobil uygulamanın zydemlak.com'a proje yayınlayabilmesi için ortak yayın anahtarı.
# Server tarafında tercih edilen isim ZYD_MOBILE_PUBLISH_TOKEN; eski mobil kurulumlarla
# uyumluluk için ZYD_PUBLISH_TOKEN da kabul edilir.
ZYD_MOBILE_PUBLISH_TOKEN=
ZYD_PUBLISH_TOKEN=

# Projeler haritası için HTTP referrer kısıtlı Google Maps JavaScript API anahtarı.
GOOGLE_MAPS_BROWSER_KEY=

# EİDS bağlantı bilgileri admin panelindeki Site Ayarları > EİDS Bağlantısı sekmesinden veritabanında yönetilir.
# Aşağıdaki değerler yalnızca ilk kurulum / fallback içindir.
EIDS_COMPANY_CODE=
EIDS_BASE_URL=https://ws.gtb.gov.tr:8443
EIDS_VERIFY_PATH=/EidsTasinmazAPI
EIDS_USER_CODE_PATH=/EidsApi/Kullanici/GetKullaniciKodu
EIDS_HEALTH_PATH=/EidsApi/health
EIDS_SSO_URL=https://eids.ticaret.gov.tr/oturum
EIDS_CALLBACK_URL=https://zydemlak.com/eids/callback
EIDS_TIMEOUT=20

# Gemini: server only. Never put the actual key in this example or source control.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite
GEMINI_TIMEOUT=12
GEMINI_MAX_OUTPUT_TOKENS=1200
GEMINI_USER_DAILY_LIMIT=50
GEMINI_SERVER_DAILY_LIMIT=1000
GEMINI_DAILY_TOKEN_BUDGET=2000000
# Optional verified prices for the configured model; blank means no cost estimate.
GEMINI_INPUT_USD_PER_MILLION=
GEMINI_OUTPUT_USD_PER_MILLION=
